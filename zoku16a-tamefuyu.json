   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "谷かけや子日にもるゝ岩れ松たれにひかれて春やしるらん",
   "kana": "",
   "speaker": "なイ",
   "page": 90,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "雲の色はまた暮はてぬ空なから霞に消る遠の山のは",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "あけわたる空にしられて久堅の雲ゐはるかに春やたつらん",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "空は猶雪けなからの朝曇くもるとみるも霞えけり",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "さらに又こそとやいはん年のうちにふたゝひ同し春は立なり",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "朝みとり霞の衣立かへて山は雪けの雲ものこらす",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "うちなひき里こそかすめ遠近の朝けの煙春やたつらむ",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "わたつ海や鹽のひるまも濱楸かすみのみをや又うつむらん",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "あまのとのあけ行そらに霞つゝまたあらたまる春はきにけり",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "かきくらし猶しら雪はふるすにもかはらぬ春と鶯そなく",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "初春の子日の小まつ引そへてかさなる千代のすへそ久しき",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "なかぬまは春もあらしとおもへともけさたのまるゝ鶯のこゑ",
   "kana": "",
   "speaker": "",
   "page": 90,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "朝な〓〓おのれ鳴てや驚のとし立かへる春やしるちむ",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "吹まよふ磯山あらし春さえて沖つ鹽あひに淡雪そふる",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "谷ふかきをのかふるすの朝戶いてにあくれはいそく鶯のこゑ",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "立わたる復の上の山かなになを空さむく雪はふりつゝ",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "咲そむる花かとみれは鶯のこつたひ〓す春のあは雪",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "尋てそ梢につらき梅かゝのしるへとまちし風のまよひは",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "袖にこそうつしかさぬれ道のへのかきねあまたの梅の匂ひを",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "夜をこめて春とつくえくれ竹の籬にきゐる鶯の聲",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "さそひ行にほひそとまる梅のはな袖こそ風のやとりならねと",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "いつしかも野へに心のあくかるゝ春のならひとわかなつむん",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "たかしめしのへともわきてみえぬまてよもの里人若なつむん",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "咲しより軒端の梅の匂ひをは花にもそへよさそふ春風",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "けふそつむいくかと待し春日野の飛ひのゝへの春のわかなは",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "梅のはなしるへなくとも尋みむ吹かたにほふ風のたよりに",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "けふはみなわかなつみにとそともなる野澤の水に袖やぬれ南",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "朝ろとり色そめかけて春風の枝にみたるゝ靑柳の糸",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "あしひきの山田のさはに雪きへて若菜つむへき時はきにけり",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "立よりてみてこそゆかめ玉梓のゆきゝのみちの靑柳のいと",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "里人は今や野原にふる雪の跡もおしますわかなつむらん",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "道のへの河そひ柳いとはやも春くる色にうち擧つゝ",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "さへかへり山風あらしときは木にふりもたまらぬ春のあは雪",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "靑柳のいとのみとりも長閑にてちらさぬ風にむすふ白露",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "立かへり又きさらきの空きえてあまきる雪にかすむ山のは",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "日影さすかきほの需のむら消にまつもえいつる春の若草",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "みわたせは一つみとりの草わかみそれともみえぬ野への色哉",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "うたてなとうつるかゝみの池水にくもるをしらて花の散らん",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "春たては雪けの水やぬるからんまつもえいつる下わらひ哉",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "いたつらに雪とふりぬる山櫻けふ尋てもみるかひそなき",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "はるのよのあらしや空にさむからし霞もなれぬ月のかけ哉",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "いつのまにとをさかるらんかへるさの跡は霞の春のかり金",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "山かけに花まつ程のさひしさの詠にそへて春雨そふる",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "おもひたつをのか時とやあまつ空かすみより行春のかりかね",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "この下の苦のみとりもみえぬまて八重散しける山櫻かな",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "雲ゐまてあかるひはりもある物をうきかけしつむのへの澤水",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "春ののゝまたはつかなる草はより空まてあかる夕ひはり哉",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "行さきの雲は櫻にあらはれてこえつる峰の花そかすめる",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "雲のたて置のぬきにをりはへて花はにしきのなこそ立けれ",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "小山田の苗代水もせきわけて豐なる世にまかせてそみる",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "君かへむ御代の爲とやさくら花うへて千とせの春をまたまし",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "暮かたき空にはなにゝ思ひけん過る程なき春の日數を",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "けふみすはかひなからまし散もせす咲ものこさぬ山櫻かな",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "花鳥のさきたつかたにさそはれてけふやとまらす春も行らん",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "をる人をわきていさめむ九重のみはしの花に風はふくとも",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "けふよりは蟬の羽衣をりはへてたゝひとへにそ夏はきにける",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "さそひ行風にもあへすうつる也神のいかきに咲る櫻は",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "よしさらはぬきたにかへむ花衣今はあたなる春のかたみに",
   "kana": "",
   "speaker": "",
   "page": 91,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "靑葉にもしはし殘るとみし花の散はさなからしける頃哉",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "ほとゝきす人のまとろむ程とてや忍ふる頃はふけて鳴らん",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "またれつる身をこそたのめ時島かたらふ聲はたれとなけれと",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "みるからにすゝしからまし雪とのみまかひもはてぬ宿の卯花",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "時鳥曉かけて鳴こふをまたぬねさめの人や聞らむ",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "卵花のむら〓〓咲る垣ねをは雪まの月の影かとそみる",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "捕にこそうつらさりげれ如花の垣ね計のよはの月かけ",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "里わかすなけやさ月のほとゝきす忍ひし比はうらやみはせし",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "山里の卯花垣の中つ道雪ふみ分し心地こそすれ",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "おなしくは聞さためはやとをさかる聲は雲ゐの山子規",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "もろは草かけてわたりし昔をは神もわするな賀茂の川波",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "軒近き花橋のにほひにはかたみや遠きむかしならまし",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "なれたにもかたらひすつな子短物思ふころのよはのれさめを",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "たち花のにほはさりせはふりにける昔なからの宿もしられし",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "一聲のおほつかなきにほとゝきすわれも聞つといふ人もかな",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "道のへの山田のみしめ引はへてなかきひつきにさなへとるこ",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "ひと聲も鳴てしらせよ足引の山郭公いつらなるらん",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "山かけやたこのをかさの夕風にすゝむともなくとるさ苗かな",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "人つてに聞そめしより時鳥なか鳴こゑをまたぬ日はなし",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "まてはこそつれなかるらめ郭公おもひすてゝや初音きかまし",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "あやめ草何とふくらむ五月雨はもらてあるへき軒ならなくに",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "時鳥またうちとけぬ一聲もうの花かけに有つゝそなく",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "さなへとるしつか小山田ふもと迄雲もをりたつ五月雨の比",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "五月雨のけにふる空はとちはてゝ雲の行きをみるほともなし",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "夏衣立よる袖やうすからし山下風もさゆるひ室に",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "つれもなきたか槇のとを明る迄たゝきもすてぬくゐな成らむ",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "山本の償の木かけの夕すゝみ岩もる亦に〓風そふく",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "大井川いく灌のほれは鵜かひ舟風の山のあけ渡るらむ",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "わすれては秋かとそおもふ小くら山音もすゝしきみねの松風",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "くるゝより謠とみたれて夏草のしけみにしけくとふ營かな",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "風ふけは河邊涼しくよる波の立かへるへき心地こそせれ",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "消やらぬおもひ成らし夏のよのみしかき程にもゆる螢は",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "〓水せく山下かけの苔莚こゝにはしかし秋きたりとも",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "しけり行草は夏のにふかく共道あるよには人もまよはし",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "暮かゝる夏のゝすゝき初を花秋風またて露そこほるゝ",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "うちわたるあさゝは水の影をたによそにへたてゝしける夏草",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "みそきする河せにさよや更ぬらんかへる秩に秋風そふく",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "露をたにうらもはらはぬとこ夏のたかうき中の花に咲らん",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "袖のうへにいつともわかぬ白露の草はに結ふ秋はきにけり",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "曇りつるたゝひとむらの跡みえてまたなこりなき夕立の空",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "いつしかと秋の初をけふとてやまつ身にしみて風の涼しき",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "更てこそをくへき露をよひのまにしはしみせたる夏のよの月",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "昨日まて人にまたれし凉しさををのれといそく秋の初風",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "みるまゝにすゝしかりけり夏のよの月にも秋の影やそふらん",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "いとはやも身にしみぬるか吹そめてけふはいくかの袖の秋風",
   "kana": "",
   "speaker": "",
   "page": 92,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "露やなををきまさるらん野原なる草はもわきて夜そしらるゝ",
   "kana": "",
   "speaker": "前參譜爲冬集癖",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "露結ふしのゝをすゝきほに出ていはねとしるき秋はきにけり",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "いかなれは秋のならひをさしもやと思ふにもなをすくる夕暮",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "久かたの雲ゐはるかに待わひし天津星合の秋もきにけり",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "山里もかくやはおもふさひしさの心にかよふ秋の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "天の川空すみわたれゆふつくよおほつかなさもはるゝ計に",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "から衣すそのゝあさち分行ははや風立ぬ秋の夕暮",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "久かたのあまつ屋合のかけそへて雲ゐにみゆる夜はの月影",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "下荻のはのほる露をほともなくしつくになして秋風えふく",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "秋をしる七夕つめの袖の露こよひもほさぬ泪なるらん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "萩のはに今はた露を吹たてゝ人にしらるゝ秋のはつ風",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "天河あふせはしはしよとむともなかれてふかき契りへけり",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "風吹は今や籬の荻のはもおのれそよきて秋を知らん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "天河いかになかれて七夕の年にあふ淑はかはらさるらん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "乙女子かかさしの萩の花のえに玉なかされる秋の白露",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "萩の葉にをきあまれはや秋の露わくれは袖に色と成らん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "彦星のつままちえてやはこふらんちりつもりにしとこ夏の花",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "露なから色かはるより秋風の吹をうらむるのへのくす原",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "やすらはてはや渡さなん一とせにひとたひかよふ天の河ふね",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "かへるさの天の河舟かちをたえたとる波路に袖しほるらん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "さそはれて今そなくなる秋風のふかはと待し初属の聲",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "いつくよりをくともしらぬ白露の暮れは草の上にみゆらん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "かた山のはゝその梢色つきて秋風さむくかりそ鳴なる",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "秋風の吹とせしまにさそはれて空にそきなく初鴈のこゑ",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "あしひきの山のはたかく成にけり嵐のよそにすめる月かけ",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "人しれす待たてる哉あしひきの山よりいつるかつらなとこを",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "我宿のわさ田かりかねいつしかと雲ゐをわたる友よはふなり",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "花すりの衣そ露にぬれにける月待宵の旅の雲ゐに",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "別てふ〓ををはしらぬさをしかも鳴てやよそのれさめとふらん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "ときは山かはる梢はみえねとも月社秋の色に出けれ",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "あしひきの山の秋風さむきよに猶妻戀の鹿そなくなる",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "ふかきよの露ふきむすふ木枯に空さへのほる山のはの月",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "山風やすそのに近く家ゐしてをしか妻とふ聲なれにけり",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "しきたへの床のうらはの波まくらやとるや月のうきね度らん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "鳴あかす友とはきけと葢思ふ心はかよひしもせし",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "もろこしの山人今もおしむらんまつらかをきの明方の月",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "我計淚はあらしきり〓〓すおなしね覺にねをは鳴とも",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "いかならんよゝもわすれし九重の秋の雲ゐになるゝ月かけ",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "夜さむとはおもはぬ閨のきり〓〓す壁迄きてもねをのみそ鳴",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "むすひをく柴の庵のしはしたに月みぬよはゝえやはすまれん",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "夕暮の月より先に關こえて木下くるゝきりはらのこま",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "まちいつる月のあたりの浮雲によきよとはらふ松風そふく",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "久方の雲井に月はすみぬれはてらさぬ方もあらしとそおもふ",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "空にのみたつ河きりもひまみえてもりくる月に秋風そふく",
   "kana": "",
   "speaker": "",
   "page": 93,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "白露ももるやかりほの小山田に猶いねかての秋風そふく",
   "kana": "",
   "speaker": "前參議爲冬卿第",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "むらしくれはれつる跡の山かせに露よりもろき峯の紅葉は",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "今よりのねさめの空の秋風にいかにせよとて衣うつらん",
   "kana": "",
   "speaker": "野やイ",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "ふりはつるわれをもすつな春日山おとろか道の霜の下草",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "初しもの置あへぬ色もかはりけり露の鐘のし6菊の花",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "みなと江の氷にたてるあしのはに夕霜さやきうら風そふく",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "くちなしの一しほ染のうす紅葉いはての山はさそ時雨らん",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "木のはなきむなしき枝にとし暮て又めくむへき春そ近つく",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "玉針の道の行てのはし紅葉をちこち人や折てかさゝむ",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "冬草の上計にはをかねともむら〓〓みゆるけさの霜かな",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "いつとてもかゝる人めの山里は草のはらにそ冬をしりける",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "はやきせにめくるみなはのうきなから氷りてとまる山川の水",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "冬のくるあらしを寒みかみなひのみむろの山や先しくるらむ",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "春きては先せきわけし苗代の田中の水も氷る頃かな",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "いつしかとけさはしくれのをとは山秋をのこさすらる紅葉哉",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "立かへるなともきこえす冬河のいしまに氷る水のしら波",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "はれくもろほとたに見へす初時雨ふりあへぬまに冬はきに鳬",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "をし鳥のよとこの池のうき枕こほらぬ水のひまもとむらし",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "をのつからふかぬたえまもあらし山なに誘はれて散このは哉",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "さゆるよに衣かたしく床の霜袖の氷に月やとるなり",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "なかきよのね覺の涙ほしやらて袖より氷る有明の月",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "袖まてもまたもらさねはよな〓〓の月たにしらぬ泪えけり",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "てる月の天の戶わたる友千鳥さやかにつくる萬代のこふ",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "忍へたゝしらせて後のつらからはいはぬ賴みもあらし物ゆへ",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "鹽風のさゆる浦はの波の音に聲うちそへてたつ千鳥かな",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "たへてしもつゝみはてしと歎ても昨日はみえし袖の色かは",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "氷るよはうへたにさむき池水にすむにほとりの下こほるらん",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "あたにのみむすひすてける契をもなをさりに待夕くれそなき",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "連水につかはぬ爲はねぬなはのくるよもなしとねをや鳴らん",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "いか計あひみんよはをかさねてか我むつとのかきりしられん",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "分行は野へのをさゝのうへよりも袖にたまらてふる霞かな",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "かねてより人の心もしらぬよにちきれはとてもいかゝ頼まん",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "ましはかるをのゝほそ遣跡たえてふかくも雪の成にけるかな",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "こぬ人をまつのこのまのよはの月ふけてそまさる心つくしは",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "霜かれの草にやつるゝふる網に今朝初雪のめつらしき哉",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "183",
   "text": "僞のうきにもたへてまたれける身はならはしの夕暮の空",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "184",
   "text": "春秋のすてゝわかれし空よりも身にそふとしの暮そ悲しき",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "185",
   "text": "つれなしとうらみそかくる自妙の袖のわかれや有明の月",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "186",
   "text": "契らすと田にも誰かまよはまし忘られぬへき〓とのはならは",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "187",
   "text": "せめてわれ後のうきなはしらす共あひみん迄も猶やしのはん",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "188",
   "text": "とのはゝうきにつけてもなきものをかこつや淺き心なるらん",
   "kana": "",
   "speaker": "",
   "page": 94,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "189",
   "text": "立かへりおなし野原にあくかれて花も紅葉も身にそなれぬる",
   "kana": "",
   "speaker": "前參議爲冬瘤集",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "190",
   "text": "七夕のとしのわたりのはるけさも我中河のあふ瀨にそしる",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "191",
   "text": "鹽風のあら磯かけておきつ波猶よせかへる音のひまなき",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "192",
   "text": "面かけをわすれぬ計かたみにて待しににたる山のはの月",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "193",
   "text": "秋過て猶いかならんもるほとにさひしかりつる小山田の庵",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "194",
   "text": "あふ〓となまつとしならは〓とのはゝかはらぬなかの契ともかな",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "195",
   "text": "峯となみ吹すきてくる松風にこたへてそよく庭のかきしは",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "196",
   "text": "君にそふ心もいまやかけろふの夕そわきておもひみたるゝ",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "197",
   "text": "山もとの松のかこひのあれまくに嵐よしはし心してふけ",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "198",
   "text": "よもすかららゆる螢に身をなしていかて思ひの程をみせまし",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "199",
   "text": "すまはまたすまれこそせめ山里はかけひの水のあるに任せて",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "200",
   "text": "かへりてやうらみもすへき外さまにひきはなされしま弓月弓",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "201",
   "text": "足引の山としたかきみねに生る松は干とせのかけそ久しき",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "202",
   "text": "大舟のまほの手なはの風をいたみひくかたしけき人に戀つゝ",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "203",
   "text": "しはましるそのゝむら竹折かけて里しめてけるたれか垣ねそ",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "204",
   "text": "のとかなる宅のねさめの潜しさに島の八聲をかそへてそきく",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "205",
   "text": "露しけき岡へのをさゝ折ふしに我世をなにゝおもひわふらん",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "206",
   "text": "谷風は今朝よりも猶山人のかへる袖にそ吹まさりける",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "207",
   "text": "みこもりの入江にしける芦の根のうきにつけてはよを賴つゝ",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "208",
   "text": "分わふる行ゑもいとゝしら雲のかさなる山にくるゝ空哉",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "209",
   "text": "舟よせぬかた山かけの河岸に苔のみむして人はかよはす",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "210",
   "text": "旅人の曉いそく關の戶は鳥の音よりや明はしむらん",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "211",
   "text": "さめてこそはかなかりけれ思ひれに數々みつる夢の名こりは",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "212",
   "text": "あしたつのたてるやいつく島かくれ波のたえまに聲計して",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "213",
   "text": "とりものに顏は隱れてみえわかす出るかたては誰にか有らん",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "214",
   "text": "なかきよの更行程のかけみえて光そうすき窓のともしひ",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "215",
   "text": "九重に久しくめくる諸人の老せぬ秋のきくのさかつき",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "216",
   "text": "こきいつる浦路はるかに成にけりかちをととをしおきつ島人",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "217",
   "text": "御垣守つきしあつちにいつしかとけふ社まとをかけ始けれ",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "218",
   "text": "もろ人のゆさゝをいそくたよりにそ道ある御代の程は知るゝ",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "219",
   "text": "音さゆるみたらし河にかけみえて袖をつらぬる春の舞かな",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "220",
   "text": "軒ちかき松のこのまのほとなきに千里の空のはてをみる哉",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "221",
   "text": "今よりの千年の後の千とせをも君にかそへてありかずにせん",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "222",
   "text": "いきてよにさのみは何か歎くらん思へは人のかすならぬ身を",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "223",
   "text": "やすみしるやまといはねの君か代をてらす日影の限なき哉",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "224",
   "text": "身一つをたつるそからきもしほやく浦のとまやの煙ならねと",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "225",
   "text": "道しあれは日數のまゝにふる雨の惠やよもの海にみちなん",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "226",
   "text": "あひにあへる時とはしるや松虫のまつにかひある御代の惠を",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "227",
   "text": "千早振みむろの榊ゆふかけて祈るも君か萬代のため",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "228",
   "text": "過にけるよそちあまりの程たにも猶しのはるゝ我むかし哉",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "229",
   "text": "花の色は子とせをかれて古往のためしにきさる春にも有哉",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "230",
   "text": "めくりあふ雲ゐの月にいく度かいてゝつかへし秋をこふらん",
   "kana": "",
   "speaker": "",
   "page": 95,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "231",
   "text": "雲のうへに光さしそふ秋の月やとれる池に千代や住へき",
   "kana": "",
   "speaker": "前参議爲冬卿集",
   "page": 96,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "232",
   "text": "千代やへむ君か齡の春にあひて松もときはの色まさりつゝ",
   "kana": "",
   "speaker": "",
   "page": 96,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "233",
   "text": "こたかくて綠もふかき松にこそ君か干とせのかけはみえけれ",
   "kana": "",
   "speaker": "藤原元晴",
   "page": 96,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
